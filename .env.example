AGENTSHIELD_RULES_PATH=data/policy_rules.json
AGENTSHIELD_DATA_DIR=data
AGENTSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model providers are called only by the backend. Copy this file to .env, add
# one key for the selected provider, then change mode to online. Never commit .env.
AGENTSHIELD_LLM_API_KEY=
AGENTSHIELD_LLM_PROVIDER=gemini
AGENTSHIELD_LLM_MODEL=gemini-3.6-flash
AGENTSHIELD_LLM_MODE=offline
AGENTSHIELD_LLM_BASE_URL=

# Comma-separated online agents: target,red_team,policy,risk,audit,judge
AGENTSHIELD_LLM_ENABLED_AGENTS=target,red_team,policy,risk,audit,judge
AGENTSHIELD_LLM_TIMEOUT_SECONDS=30
AGENTSHIELD_LLM_RETRY_ATTEMPTS=4
AGENTSHIELD_LLM_MAX_INPUT_CHARS=30000
AGENTSHIELD_LLM_MAX_OUTPUT_TOKENS=2048
AGENTSHIELD_LLM_MAX_ONLINE_BATCH_SIZE=20

# Keep model interactions stateless and fail visibly instead of pretending an
# offline fallback was model-generated. Both settings are production defaults.
AGENTSHIELD_LLM_STORE_INTERACTIONS=false
AGENTSHIELD_LLM_FALLBACK_TO_OFFLINE=false

# Fixed stored tool calls remain the reproducible evaluation input by default.
# Set true only for a separate tool-call-generation experiment.
AGENTSHIELD_LLM_REGENERATE_STORED_TOOL_CALLS=false
